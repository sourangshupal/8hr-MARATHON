# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY="gsk_your_token"
GROQ_FALLBACK_API_KEY="gsk_another_token"

NVIDIA_API_KEY="nvapi_your_token"
OPENAI_API_KEY="sk-proj_your_token"

# Jina AI Embeddings + Reranker API
JINA_API_KEY="jina_your_token"

# Production persistence (Neon serverless Postgres) & cache (Upstash Redis)
NEON_DB_URL=postgresql://user:password@host.neon.tech/enterprise_rag?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Portkey LLM Gateway
PORTKEY_API_KEY="your_token"
PORTKEY_PRIMARY_CONFIG_ID="pc-portke-your_token""
PORTKEY_PRIMARY_SLUG="gpt-4o-mini"
PORTKEY_FALLBACK_SLUG="gemini"

# API safety
RAG_API_KEY="TEST_RAG_API_KEY_1234567890"
RATE_LIMIT_PER_MINUTE=20

# Qdrant Vector DB Settings 
QDRANT_API_KEY="your_token"
QDRANT_CLUSTER_ENDPOINT="your_url_endpoint"

# === Observability

# Pydantic Logfire Observability
LOGFIRE_TOKEN = "pylf_v2_your_token"

# LANGSMITH 

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="enterprise-rag"

BACKEND_URL="http://localhost:8000"

JUDGE_GROQ = "gsk_your_token"

GEMINI_API_KEY = "your_token"
